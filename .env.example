# ForwardDeploy OS environment variables. Every variable is optional for local
# development; the whole site works with none set (deterministic mode).
# Never commit a real .env file.

# Required in production: signs human-in-the-loop checkpoints (HMAC-SHA256).
# Generate one with: npm run secret
CHECKPOINT_SECRET=replace-with-64-hex-chars

# Optional LLM layer (Groq free tier). Without a key the engine runs deterministically.
GROQ_API_KEY=
# Pin the model id you checked on Groq's model list.
GROQ_MODEL=llama-3.3-70b-versatile
# Daily cap on LLM requests across the site; after it the site falls back to deterministic mode.
LLM_DAILY_CAP=300

# Random token placed in the LLM system prompt; a leak aborts the run. Generated at boot if unset.
CANARY_TOKEN=

# Optional: real Slack incoming webhook for HITL notifications.
SLACK_WEBHOOK_URL=

# Optional: shared rate limiting (Upstash Redis free tier). Without it, limits are per instance (best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL used in deep links (Slack messages, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
