{
  "name": "forward-deploy-os",
  "version": "2.0.0",
  "private": true,
  "description": "Self-healing enterprise ETL, DOM-distilled browser agent and human-in-the-loop reconciliation platform. Runs at $0.",
  "author": "Ameer Sohail Shaik",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:redteam": "vitest run tests/red-team",
    "test:e2e": "playwright test",
    "samples": "tsx scripts/generate-samples.ts",
    "calibrate": "tsx scripts/generate-calibration-set.ts && tsx scripts/fit-calibrator.ts",
    "bench": "tsx scripts/run-benchmarks.ts",
    "bench:check": "tsx scripts/run-benchmarks.ts --check",
    "build:distiller": "tsx scripts/build-distiller.ts",
    "runner": "tsx runner/agent-runner.ts",
    "baseline": "tsx runner/baseline-script.ts",
    "mcp": "tsx mcp-server/server.ts",
    "screenshots": "tsx scripts/screenshot-assets.ts",
    "record-demo": "tsx scripts/record-demo.ts",
    "readme:results": "tsx scripts/update-readme-results.ts",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "fast-check": "^4.10.2",
    "gpt-tokenizer": "^4.0.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
